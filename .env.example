# Aletheia settings. Copy this file to .env (next to app.py) and change what you need; a variable already set in the
# environment wins over this file. Every value below is the default.

# ---- server
# 127.0.0.1 = this computer only; 0.0.0.0 = reachable from the lab network
ALETHEIA_HOST=127.0.0.1
PORT=5000
ALETHEIA_THREADS=8
ALETHEIA_LOG_LEVEL=INFO
# 1 when Aletheia is served over HTTPS (behind a reverse proxy with a certificate): the session cookie is sent encrypted only
ALETHEIA_HTTPS=0

# ---- accounts
# 0 = dummy / demonstration version: no sign-in, the View as menu switches between Customer, Tester and Admin.
# 1 = the real system: passwords, lock-out, password re-entry at release; the View as menu disappears.
ALETHEIA_PASSWORDS=0
# 0 turns the View as menu off even while passwords are off
ALETHEIA_ROLE_SWITCH=1

# ---- data
# records database (ai_cache.db, .aletheia_secret and backups/ are kept in the same folder)
# ALETHEIA_DB=C:\Aletheia\aletheia.db
# ALETHEIA_BACKUP_DIR=C:\Aletheia\backups
ALETHEIA_BACKUP_KEEP=30
ALETHEIA_AUTO_BACKUP=1
# report wording and laboratory details
# ALETHEIA_TEMPLATE=report_template.json

# ---- optional: reading scanned sheets with an AI model (off by default; Excel is the primary input)
ALETHEIA_FEATURE_SCAN=0
# a model on this computer (Ollama) or any OpenAI-compatible service ...
# AI_BASE_URL=http://localhost:11434/v1
# AI_MODEL=qwen2.5vl:7b
# AI_API_KEY=
# ... or Google Gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=
# AI_TIMEOUT=300
# ALETHEIA_DAILY_CALL_LIMIT=

# ---- demonstration data: 1 lets /api/demo load the demo job with its scanned sheets
ALETHEIA_DEMO=0
